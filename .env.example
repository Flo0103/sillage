# Nom DNS uniquement, sans https:// ni chemin.
SILLAGE_DOMAIN=gravel.example.com
# Adresse de contact pour les certificats HTTPS.
ACME_EMAIL=votre-adresse@example.com
# Généré sur le VPS par bash deploy/configure.sh, jamais dans Git.
# POSTGRES_PASSWORD=...

# Créer une application sur https://www.strava.com/settings/api
# Domaine de callback : sillage.gravelspa.be
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Clés générées et conservées par deploy/configure.sh (ne pas remplacer ensuite).
# STRAVA_TOKEN_KEY=...
# STRAVA_WEBHOOK_SECRET=...
